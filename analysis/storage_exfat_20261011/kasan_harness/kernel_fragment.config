# 相机驱动祖先复现：v5.7 fs/exfat + KASAN + virtio 块设备
CONFIG_EXFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_OUTLINE=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_MMIO=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_KALLSYMS=y
CONFIG_FRAME_POINTER=y
CONFIG_RANDOMIZE_BASE=n
CONFIG_MODULES=n
CONFIG_DEBUG_INFO=n
CONFIG_LOCALVERSION="-kasancam"
